# DomainX optional configuration.
# Copy to .env for local development. All variables below are optional --
# DomainX's core Legal/Medical/SupplyChain engines are fully deterministic
# and need none of this. These only affect the AI Executive Summary feature
# (POST /api/v1/ai/summarize), which degrades to a deterministic template
# narrator automatically when Ollama is unreachable.

# Base URL of a local or self-hosted Ollama daemon (https://ollama.com).
# Install Ollama, then run: ollama pull llama3.2:1b && ollama serve
OLLAMA_HOST=http://localhost:11434

# Any model you have pulled locally. Small, fast, free-tier-friendly choices:
# llama3.2:1b, qwen2.5:0.5b, phi3:mini
OLLAMA_MODEL=llama3.2:1b

# Seconds to wait for Ollama before falling back to the template narrator.
OLLAMA_TIMEOUT_SECONDS=4
